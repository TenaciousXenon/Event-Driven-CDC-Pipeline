{
  "settings": {"number_of_shards": 1, "number_of_replicas": 0},
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "deleted": {"type": "boolean"},
      "data": {
        "type": "object",
        "dynamic": true,
        "properties": {
          "id": {"type": "long"},
          "name": {"type": "text", "fields": {"keyword": {"type": "keyword"}}},
          "payload": {"type": "text"}
        }
      }
    }
  }
}
